# Umojaverse - umojaverse.xyz
# Optional: use a confirmed Discord, Telegram, or other community invitation URL.
# If unset, the community page links to the verified Umojaverse X profile.
NEXT_PUBLIC_COMMUNITY_URL=

# Optional: a confirmed partnership inbox. Enables the email-draft handoff.
# The site does not claim to send mail or collect form submissions.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (content dashboard: programs, blog, image uploads) ---
# Project Settings > API. Without these the site falls back to the static
# content in src/lib/site.ts and /admin shows a setup notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used for writes and uploads. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Required for dashboard access: comma-separated administrator email addresses.
# Leave empty to disable all administrator access.
ADMIN_EMAILS=
